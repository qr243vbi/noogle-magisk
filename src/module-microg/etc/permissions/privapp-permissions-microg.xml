    <privapp-permissions package="com.android.vending">
        <permission name="android.permission.INTERNET"/>
        <permission name="android.permission.POST_NOTIFICATIONS"/>
        <permission name="android.permission.ACCESS_COARSE_LOCATION"/>
        <permission name="android.permission.ACCESS_NETWORK_STATE"/>
        <permission name="android.permission.FOREGROUND_SERVICE"/>

        <!-- Package Management -->
        <permission name="android.permission.REQUEST_INSTALL_PACKAGES"/>
        <permission name="android.permission.QUERY_ALL_PACKAGES"/>
        <permission name="android.permission.INSTALL_PACKAGES"/>
        <permission name="android.permission.DELETE_PACKAGES"/>

        <!-- MicroG & Google Play Ecosystem -->
        <permission name="org.microg.gms.permission.READ_SETTINGS"/>
        <permission name="org.microg.gms.permission.WRITE_SETTINGS"/>
        <permission name="com.google.android.gms.permission.READ_SETTINGS"/>
        <permission name="com.google.android.gms.permission.WRITE_SETTINGS"/>
        <permission name="com.google.android.gms.auth.permission.GOOGLE_ACCOUNT_CHANGE"/>
        <permission name="com.android.vending.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"/>
        <permission name="android.permission.FAKE_PACKAGE_SIGNATURE"/>
