        <permission name="com.google.android.gms.auth.permission.GOOGLE_ACCOUNT_CHANGE"/>
        <permission name="com.google.android.c2dm.permission.RECEIVE"/>
        <permission name="com.google.android.c2dm.permission.SEND"/>
