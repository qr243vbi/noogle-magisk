        <permission name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
        <permission name="android.permission.FAKE_PACKAGE_SIGNATURE"/>
        <permission name="com.google.android.gms.permission.AD_ID"/>
